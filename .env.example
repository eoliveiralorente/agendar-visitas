# Copie para .env e preencha (não comite o .env).
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080

# PostgreSQL. Sem DATABASE_URL o app usa memória (os dados somem ao reiniciar).
DATABASE_URL=postgres://agenda:senha@localhost:5432/agenda
DATABASE_SSL=false

# Gere com: openssl rand -hex 32
SESSION_SECRET=

# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Quem pode entrar (separe por vírgula). Use pelo menos um dos dois.
ALLOWED_DOMAINS=suaempresa.com.br
ALLOWED_EMAILS=

# Login sem Google, só para desenvolvimento local
DEV_LOGIN=true
